<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The base package carries the ABCChrome146 engine for Windows; Linux needs the engine package as well. -->
    <PackageReference Include="ABCpdf" Version="14.0.6" />
    <PackageReference Include="ABCpdf.ABCChrome146.Linux" Version="14.0.6" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
</Project>
